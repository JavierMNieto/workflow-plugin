#!/usr/bin/env node
// `plans`: the workflow's command, on the Bash tool's path while the plugin
// is enabled (`bin/`). `plans help` prints what it takes.
import { execFileSync } from "node:child_process";
import { readFileSync, realpathSync } from "node:fs";
import { basename, dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

// The command acts on the repository it is run in. A chat in one project can
// run `plans` in another's checkout, and the Bash tool may carry the chat's
// `CLAUDE_PROJECT_DIR`, so the queue's root is said here, before the import.
// In a linked worktree (`.claude/worktrees/<name>`) the root is still the
// checkout that holds `plans/`: the folder above the shared `.git`.
const git = (...args) =>
  execFileSync("git", args, {
    cwd: process.cwd(),
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  }).trim();
try {
  const common = git("rev-parse", "--path-format=absolute", "--git-common-dir");
  process.env.WORKFLOW_ROOT =
    basename(common) === ".git" ? dirname(common) : git("rev-parse", "--show-toplevel");
} catch {
  process.env.WORKFLOW_ROOT = process.cwd();
}

const here = dirname(fileURLToPath(import.meta.url));

// An incomplete copy is said plainly, not as a stack trace. When the check is
// the file that is missing, `fallback()` stands in: the check's `fix()`
// written again, from this copy's path alone, as the manifest's shell is;
// `test/plugin.test.ts` holds the three to one text on every layout.
const root = join(here, "..");
function fallback(root) {
  const folder =
    "This copy is loaded from a folder, not the plugins cache: put them back in that folder, then start a new chat.";
  const cached = /^(.*)[\\/]cache[\\/]([^\\/]+)[\\/]([^\\/]+)[\\/]([^\\/]+)$/.exec(root);
  if (!cached) return folder;
  const [, plugins, marketplace, plugin, version] = cached;
  let installed = true;
  try {
    const record = readFileSync(join(plugins, "installed_plugins.json"), "utf8");
    installed = record.includes(JSON.stringify(root));
    // A symlink above the cache: this path is resolved, the record's is not.
    if (!installed) {
      const real = realpathSync(root);
      installed = [...record.matchAll(/"installPath":\s*("(?:[^"\\]|\\.)*")/g)].some((m) => {
        try {
          return realpathSync(JSON.parse(m[1])) === real;
        } catch {
          return false;
        }
      });
    }
  } catch {
    // No record: on to the clone.
  }
  if (!installed)
    return "This copy is an older version that new chats do not load: start a new chat.";
  const clone = join(plugins, "marketplaces", marketplace);
  let head = "";
  try {
    head = execFileSync("git", ["-C", clone, "rev-parse", "HEAD"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
      timeout: 2000,
    }).trim();
  } catch {
    // No clone, or no git: the update form.
  }
  const command =
    head && head.startsWith(version)
      ? `git -C "${clone}" archive ${version}:plugins/${plugin} | tar -x -C "${root}"`
      : `claude plugin update ${plugin}@${marketplace}`;
  return `The fix: ${command}, then start a new chat.`;
}
let gone = ["scripts/install-check.mjs"];
let text = "";
let check = null;
try {
  check = await import(pathToFileURL(join(root, "scripts", "install-check.mjs")).href);
} catch {
  // The check itself is missing: the fallback says so.
  text = `The workflow plugin's installed copy is incomplete: scripts/install-check.mjs is missing, and maybe more. ${fallback(root)}`;
}
if (check) {
  gone = check.missing(root);
  // The message, and the git call its fix makes, only when something is missing.
  if (gone.length) text = check.message(root, gone);
}
if (gone.length) {
  process.stderr.write(`${text}\n`);
  process.exit(1);
}

const { main } = await import(pathToFileURL(join(here, "..", "scripts", "plan-queue.mjs")).href);
main(process.argv.slice(2));
